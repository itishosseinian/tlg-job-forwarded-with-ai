# ─── Telegram API (get from https://my.telegram.org → API development tools) ───
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+10000000000          # the phone number of the account that will READ the chats

# ─── Control Bot (create with @BotFather on Telegram, then paste the token) ───
BOT_TOKEN=123456:ABC-your-bot-token-here

# ─── OpenAI (get from https://platform.openai.com/api-keys) ───
OPENAI_API_KEY=sk-your-openai-key-here


# ─── Optional: which OpenAI model classifies messages (default: o4-mini) ───
OPENAI_MODEL=o4-mini
